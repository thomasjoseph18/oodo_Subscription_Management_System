# Copy to backend/.env. Never commit the real file.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# PostgreSQL is the project database. Empty falls back to SQLite for quick tests only.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/brightloop

# Upstash rediss:// URL. Empty runs Celery tasks inline.
REDIS_URL=

# Empty prints emails to the console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Razorpay test mode. Empty disables the online payment button.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google AI Studio key. Empty disables the assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
